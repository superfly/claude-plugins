#!/bin/sh
# Wrapper script to select the correct platform-specific binary

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"

case "$ARCH" in
    x86_64)  ARCH="amd64" ;;
    aarch64) ARCH="arm64" ;;
    arm64)   ARCH="arm64" ;;
esac

BINARY="${SCRIPT_DIR}/sprite-handoff-${OS}-${ARCH}"

if [ ! -f "$BINARY" ]; then
    echo "Error: No binary found for ${OS}/${ARCH}" >&2
    echo "Expected: $BINARY" >&2
    echo "Available binaries:" >&2
    ls -1 "${SCRIPT_DIR}"/sprite-handoff-* 2>/dev/null || echo "  (none)" >&2
    exit 1
fi

exec "$BINARY" "$@"
